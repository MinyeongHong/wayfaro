# Backend only. Never put this token in VITE_* variables or browser code.
INGESTION_ADMIN_TOKEN=
# Local backend connection; existing database identifiers are preserved.
DATABASE_URL=postgresql+psycopg://dev_user:dev_password@localhost:5432/dev_db
# Server API + worker only. Both must be configured to accept analysis requests.
GEMINI_API_KEY=
GEMINI_MODEL=
CV_MATCH_RETENTION_HOURS=24
# true in HTTPS deployments. Use false ONLY for local HTTP cookie testing.
CV_MATCH_COOKIE_SECURE=true
